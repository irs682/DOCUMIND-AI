# ==============================================================================
# DOCUMIND-AI Root Quickstart Environment Variables Template
# Grouped summary of all environment variables across backend, AI service, and frontend.
# ==============================================================================

# --- DATABASE & STORAGE ---
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/documind?retryWrites=true&w=majority
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=documind-storage

# --- VECTOR DATABASE ---
QDRANT_URL=https://<cluster-id>.<region>.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION=documind_documents
QDRANT_VECTOR_SIZE=384

# --- AUTHENTICATION ---
JWT_SECRET=your_super_secret_jwt_key_here
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here

# --- AI & LLM PROVIDERS ---
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- NETWORKING & SERVICE INTERCONNECT ---
PORT=5000
NODE_ENV=production
CLIENT_URL=https://documind-ai.netlify.app
FRONTEND_URL=https://documind-ai.netlify.app
AI_SERVICE_URL=http://127.0.0.1:8000
NODE_BACKEND_URL=http://localhost:5000
VITE_API_URL=https://documind-api.onrender.com

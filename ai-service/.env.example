# ==============================================================================
# DOCUMIND-AI Python/FastAPI AI Microservice Environment Variables Template
# Copy this file to .env and configure for your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER
# ------------------------------------------------------------------------------
APP_NAME=DOCUMIND-AI AI Service
APP_VERSION=1.0.0
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. SERVICE INTERCONNECT & CORS
# ------------------------------------------------------------------------------
# Node.js backend URL
NODE_BACKEND_URL=https://documind-api.onrender.com
# Web frontend URL
FRONTEND_URL=https://documind-ai.netlify.app

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (Qdrant Cloud or Local Docker)
# ------------------------------------------------------------------------------
QDRANT_URL=https://<cluster-id>.<region>.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION=documind_documents

# ------------------------------------------------------------------------------
# 4. EMBEDDINGS CONFIGURATION
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HF_TOKEN=

# ------------------------------------------------------------------------------
# 5. LLM PROVIDERS
# ------------------------------------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct
DEFAULT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_APP_NAME=DOCUMIND-AI
OPENROUTER_HTTP_REFERER=https://documind-ai.netlify.app

# Optional LLM fallback keys
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

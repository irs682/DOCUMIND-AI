# ==============================================================================
# DOCUMIND-AI Web Frontend Environment Variables Template
# Copy this file to .env or configure in Netlify site settings.
# ==============================================================================

# Public API Gateway URL pointing to your deployed Node.js backend
# e.g. https://documind-api.onrender.com or https://documind-api.onrender.com/api
# Leave empty in local development to use Vite's built-in /api proxy.
VITE_API_URL=https://documind-api.onrender.com

# Alternate variable name for backward compatibility
VITE_API_BASE_URL=https://documind-api.onrender.com/api

# Application title
VITE_APP_TITLE=DOCUMIND-AI

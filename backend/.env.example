# ==============================================================================
# DOCUMIND-AI Backend Environment Variables Template
# Copy this file to .env and provide your deployment-specific credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPLOYMENT & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
CLIENT_URL=https://documind-ai.netlify.app
FRONTEND_URL=https://documind-ai.netlify.app
ALLOWED_ORIGINS=https://documind-ai.netlify.app
ALLOW_NETLIFY_PREVIEWS=true

# ------------------------------------------------------------------------------
# 2. DATABASE (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/documind?retryWrites=true&w=majority
# Local format: mongodb://127.0.0.1:27017/document-ai
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/documind?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (Qdrant Cloud or Local Docker)
# ------------------------------------------------------------------------------
# Qdrant Cloud format: https://<cluster-id>.<region>.qdrant.io:6333
# Local format: http://127.0.0.1:6333
QDRANT_URL=https://<cluster-id>.<region>.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION=documind_documents
QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 4. STORAGE (Supabase Storage / Object Storage)
# ------------------------------------------------------------------------------
# If left empty, fallback stores files in backend/uploads directory on local disk.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=documind-storage

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=generate_a_secure_random_64_char_secret_here
REFRESH_TOKEN_SECRET=generate_a_different_secure_random_64_char_secret_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 6. AI MICROSERVICE & EMBEDDINGS
# ------------------------------------------------------------------------------
# Production: internal host or Render web service URL (e.g. https://documind-ai-service.onrender.com)
# Local: http://127.0.0.1:8000
AI_SERVICE_URL=http://127.0.0.1:8000
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# 7. LLM PROVIDERS
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct
DEFAULT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=DOCUMIND-AI
OPENROUTER_HTTP_REFERER=https://documind-ai.netlify.app

# Optional auxiliary providers
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
